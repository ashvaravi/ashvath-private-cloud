{
  "control_route": "mac_backend_verified_only",
  "backend_endpoints": {
    "entity": "POST /api/v1/home/control/verified",
    "group": "POST /api/v1/home/control/group/verified"
  },
  "rooms": {
    "bedroom": {
      "aliases": ["bedroom", "my room", "ashvas bedroom"],
      "devices": [
        "switch.ashvas_bedroom_strip_light",
        "switch.ashvas_bedroom_light_1",
        "switch.ashvas_bedroom_light_2",
        "switch.ashvas_bedroom_fan"
      ]
    }
